@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Vulkan 1.2)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/photara_vkTargets.cmake")
find_program(PHOTARA_VK_DXC NAMES dxc HINTS "$ENV{VULKAN_SDK}/Bin" "$ENV{VULKAN_SDK}/bin")
include("${CMAKE_CURRENT_LIST_DIR}/PhotaraVkShaders.cmake")
check_required_components(photara_vk)
